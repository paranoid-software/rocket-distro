# Rocket - copy to .env and set values
# Used by rocket-distro/docker/docker-compose.yml (pre-built images from ghcr.io).

# Container prefix. Defaults to directory name (docker) if unset.
COMPOSE_PROJECT_NAME=rocket

# Docker network name on the host (e.g. `rocket`, `primary`). Default `rocket`.
NETWORK_NAME=rocket

# If the network with NETWORK_NAME already exists on the host and was created outside this
# compose (e.g. by another stack or `docker network create`), set to true so compose attaches
# to it instead of trying to manage it. You are responsible for creating it in that case:
#   docker network create ${NETWORK_NAME}
NETWORK_EXTERNAL=false

# Which bundled infrastructure services to start. Comma-separated list of profiles.
# Remove a profile to use your own external service for that piece (then update settings.json
# hostName for the affected service to point to your endpoint).
#   bundled-mongo       Mongo + mongo-init (replica-set bootstrap)
#   bundled-opensearch  OpenSearch
#   bundled-rabbitmq    RabbitMQ
#   bundled-redis       Redis
#   bundled-logy        Logy emulator
#   bundled-zookeeper   Zookeeper emulator
COMPOSE_PROFILES=bundled-mongo,bundled-opensearch,bundled-rabbitmq,bundled-redis,bundled-logy,bundled-zookeeper

# Rocket images tag (e.g. latest, develop, or a specific sha)
ROCKET_TAG=latest

# Storage base path. Use an absolute path so it does not resolve relative to docker/.
# Example: STORAGE_PATH=/var/lib/rocket
STORAGE_PATH=./storage

# MongoDB - REQUIRED: set password
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme

# RabbitMQ - REQUIRED: set password
RABBITMQ_DEFAULT_USER=rocket
RABBITMQ_DEFAULT_PASS=changeme

# Redis - optional (empty = no auth)
REDIS_PASSWORD=

# Optional overrides (use quotes for values with spaces if you source .env in shell)
# MONGO_PORT=27017
# OS_PORT=9200
# OS_JAVA_OPTS="-Xms256m -Xmx256m"
# RABBITMQ_AMQP_PORT=5672
# RABBITMQ_MGMT_PORT=15672
# REDIS_PORT=6379
