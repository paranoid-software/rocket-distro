# Rocket - copy to .env and set values
# Used by rocket-distro/docker/docker-compose.yml (pre-built images from ghcr.io).

# Container prefix. Defaults to directory name (docker) if unset.
COMPOSE_PROJECT_NAME=rocket

# Rocket images tag (e.g. latest, develop, or a specific sha)
ROCKET_TAG=latest

# Storage base path. Use an absolute path so it does not resolve relative to docker/.
# Example: STORAGE_PATH=/var/lib/rocket
STORAGE_PATH=./storage

# MongoDB - REQUIRED: set password
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme

# RabbitMQ - REQUIRED: set password
RABBITMQ_DEFAULT_USER=rocket
RABBITMQ_DEFAULT_PASS=changeme

# Redis - optional (empty = no auth)
REDIS_PASSWORD=

# Optional overrides (use quotes for values with spaces if you source .env in shell)
# MONGO_PORT=27017
# ES_PORT=9200
# ES_JAVA_OPTS="-Xms512m -Xmx512m"
# RABBITMQ_AMQP_PORT=5672
# RABBITMQ_MGMT_PORT=15672
# REDIS_PORT=6379
